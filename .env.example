# ============================================================
# Beispiel-Konfiguration – Faszienbehandlung.jetzt
# Kopieren als .env; auf dem Server Werte als Umgebungsvariablen setzen.
# .env.production wird nicht automatisch geladen.
# ============================================================

# Server
HOST=127.0.0.1
PORT=8080
BASE_URL=https://faszienbehandlung.jetzt
# Lokale Entwicklung: BASE_URL=http://127.0.0.1:8080
# Muss exakt dem Browser-Origin entsprechen (Cookies, CSRF und OAuth).

# Datenbank (Pfad zur SQLite-Datei)
DATABASE_URL=data/faszien.db

# JWT – zufälliger 64-Zeichen-String; Rotation meldet alle Sitzungen ab
# Generieren: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_hex_string
JWT_EXPIRY_HOURS=168

# Admin-Konto (E-Mail/Passwort werden beim Start mit diesen Werten abgeglichen)
# Pflichtwerte: gültige E-Mail und 12 bis 72 Passwort-Bytes; keine Beispielwerte.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_password

# SMTP (E-Mail-Versand für Buchungsbestätigungen, Erinnerungen, Warteliste etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
SMTP_FROM=your@email.com
SMTP_FROM_NAME=Faszienbehandlung | Thilo Seifried
